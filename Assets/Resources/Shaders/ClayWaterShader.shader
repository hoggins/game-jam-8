				float screenDepth89 = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH( ScreenPosNorm.xy ),_ZBufferParams);
				float distanceDepth89 = abs( ( screenDepth89 - LinearEyeDepth( ScreenPosNorm.z,_ZBufferParams ) ) / ( _Depth ) );
				

				float Alpha = distanceDepth89;
				#if defined( _ALPHATEST_ON )

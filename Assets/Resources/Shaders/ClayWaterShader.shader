				float fresnelNdotV108 = dot( vertexToFrag110, ViewDirWS );
				float fresnelNode108 = ( _Fresnel.x + _Fresnel.y * pow( 1.0 - fresnelNdotV108, _Fresnel.z ) );
				
				float3 normalizedWorldNormal = normalize( NormalWS );
				float3 TriplanarCoords29 = ( normalizedWorldNormal * normalizedWorldNormal );
				float3 objToWorld6 = mul( GetObjectToWorldMatrix(), float4( float3( 0,0,0 ), 1 ) ).xyz;
				float3 temp_output_7_0 = ( PositionWS - objToWorld6 );
				float3 DefformShift81 = _DeformShift;
				float3 break83 = DefformShift81;
				float2 appendResult85 = (float2(break83.y , break83.z));
				float2 uvR31 = ( ( _Prints_ST.xy * (temp_output_7_0).yz ) + appendResult85 );
				float2 appendResult84 = (float2(break83.x , break83.z));
				float2 uvG32 = ( ( _Prints_ST.xy * (temp_output_7_0).xz ) + appendResult84 );
				float2 appendResult80 = (float2(break83.x , break83.y));
				float2 uvB33 = ( ( _Prints_ST.xy * (temp_output_7_0).xy ) + appendResult80 );
				float3 weightedBlendVar46 = TriplanarCoords29;
				float4 weightedBlend46 = ( weightedBlendVar46.x*tex2D( _PrintsNormal, uvR31 ) + weightedBlendVar46.y*tex2D( _PrintsNormal, uvG32 ) + weightedBlendVar46.z*tex2D( _PrintsNormal, uvB33 ) );

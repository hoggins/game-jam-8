				UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);

				float3 ase_positionWS = TransformObjectToWorld( ( input.positionOS ).xyz );
				float simplePerlin3D48 = snoise( ( ase_positionWS + _DeformShift + ( _TimeParameters.x * _TimeScale ) )*_DeformScale );
				simplePerlin3D48 = simplePerlin3D48*0.5 + 0.5;
				float3 temp_output_54_0 = ( input.normalOS *  (_DeformRemap.z + ( simplePerlin3D48 - _DeformRemap.x ) * ( _DeformRemap.w - _DeformRemap.z ) / ( _DeformRemap.y - _DeformRemap.x ) ) );
				
				float3 vertexToFrag110 = temp_output_54_0;
				output.ase_texcoord7.xyz = vertexToFrag110;
				
				
				//setting value to unused interpolator channels and avoid initialization warnings

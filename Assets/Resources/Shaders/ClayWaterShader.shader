				float weightedBlend11 = ( weightedBlendVar11.x*tex2D( _Prints, uvR31 ).r + weightedBlendVar11.y*tex2D( _Prints, uvG32 ).r + weightedBlendVar11.z*tex2D( _Prints, uvB33 ).r );
				


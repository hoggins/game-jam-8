				float lerpResult120 = lerp( ( ( triplanar13.x * _PrintsColorMul ) + _PrintsColorAdd ) , temp_output_131_0 , tex2DNode122.r);
				float4 color81 = IsGammaSpace() ? float4( 1, 0.3443396, 0.3443396, 0 ) : float4( 1, 0.09714398, 0.09714398, 0 );
